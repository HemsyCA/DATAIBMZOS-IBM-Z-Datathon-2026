# Copy of what scripts/make_env.sh writes into .env (never commit .env)
BASE_IMAGE=registry.linuxone.cloud.marist.edu/l1cc/jupyterlab-image-s390x:latest
SHARED_DIR=/home/linux1/shared
UID_GID=1000:1000
DATA_DIR=/data/sepsis
SEPSIS_HMAC_KEY=<64 hex chars from: openssl rand -hex 32>
SEPSIS_AES_KEY_HEX=<64 hex chars from: openssl rand -hex 32>
